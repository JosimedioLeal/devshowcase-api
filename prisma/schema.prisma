generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// 1. Perfil do Desenvolvedor
model Profile {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  bio       String?
  projects  Project[]
  createdAt DateTime  @default(now())
}

// 2. Projeto
model Project {
  id           String       @id @default(uuid())
  title        String
  description  String
  repoUrl      String
  profileId    String
  profile      Profile      @relation(fields: [profileId], references: [id])
  technologies Technology[]
  feedbacks    Feedback[]
  createdAt    DateTime     @default(now())
}

// 3. Tecnologia (Relacionamento N:N com Project)
model Technology {
  id       String    @id @default(uuid())
  name     String    @unique
  projects Project[]
}

// 4. Feedback (Relacionamento 1:N com Project)
model Feedback {
  id        String   @id @default(uuid())
  comment   String
  author    String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
}